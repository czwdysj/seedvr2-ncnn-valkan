+// Copyright 2021 Tencent
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef LAYER_CONVOLUTION3D_VULKAN_H
+#define LAYER_CONVOLUTION3D_VULKAN_H
+
+#include "convolution3d.h"
+
+namespace ncnn {
+
+// Convolution3D 的 Vulkan 后端：pack1 张量布局、四输出通道直接卷积
+// （不 im2col/winograd），
+// 支持显式 pad 与 SAME pad（-233/-234 在 forward 中折算为显式 pad 量）。
+// 每个 work item 在同一空间位置累加至多四个输出通道，从而复用输入读取；权重
+// 预打包为 [out/4,in,kernel,4]，使四个输出权重可由一次向量 load 读入。
+class Convolution3D_vulkan : public Convolution3D
+{
+public:
+    Convolution3D_vulkan();
+
+    virtual int load_param(const ParamDict& pd);
+
+    virtual int create_pipeline(const Option& opt);
+    virtual int destroy_pipeline(const Option& opt);
+
+    virtual int upload_model(VkTransfer& cmd, const Option& opt);
+
+    using Convolution3D::forward;
+    virtual int forward(const VkMat& bottom_blob, VkMat& top_blob, VkCompute& cmd, const Option& opt) const;
+
+public:
+    VkMat weight_data_gpu;
+    VkMat bias_data_gpu;
+
+    Pipeline* pipeline_convolution3d;
+};
+
+} // namespace ncnn
+
+#endif // LAYER_CONVOLUTION3D_VULKAN_H
